{
  "name": "cloudedtech-monorepo",
  "version": "1.0.0",
  "description": "Cloud Based Ed-Tech Platform Monorepo",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run start:dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "npx concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "seed": "node backend/seed-db.js",
    "db:clear": "node backend/clear-db.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
